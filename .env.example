# Copy this file to .env for local development or UAT. Never commit a real key.
SM_REVIEWER_AI_API_KEY=
SM_REVIEWER_AI_MODEL=gpt-4o-mini
SM_REVIEWER_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
SM_REVIEWER_AI_TIMEOUT_MS=30000

# Optional local UAT defaults. Paths stay local and are ignored by Git.
SM_SCRIPTLIBRARY_DIR=./SM-Exports/ScriptLibrary
SM_UAT_DIR=./SM-UAT

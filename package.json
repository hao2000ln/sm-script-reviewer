{
  "name": "sm-script-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:acceptance": "npm run build && node sprint2-acceptance.cjs",
    "test:uat": "npm run test:uat:sprint4",
    "test:uat:sprint4": "npm run build && node uat/sprint4/run-uat.cjs",
    "review": "npm run build && node dist/src/cli/index.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
